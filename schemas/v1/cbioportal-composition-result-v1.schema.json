                        ],
                        "type": "object"
                      },
                      {
                        "additionalProperties": true,
                        "properties": {
                          "untrusted_cohort_value": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "untrusted_cohort_value"
                        ],
                        "type": "object"
                      }
                    ],
                    "properties": {
                      "cohort_value": {
                        "type": "string"
                      },
                      "count": {
                        "minimum": 0,
                        "type": "integer"
                      },
                      "population": {
                        "type": "string"
                      },
                      "untrusted_cohort_value": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "population",
                      "count"
                    ],
                    "type": "object"
                  },
                  "type": "array"
                },
                "total": {
                  "minimum": 0,
                  "type": "integer"
                }
              },
              "required": [
                "total",
                "population_label",
                "dominant_population",
                "population_shares",
                "programmes",
                "is_single_population",
                "contains_models"
