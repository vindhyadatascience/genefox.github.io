rules_version = '2';

// ⚠️  MERGE these two match blocks into your project's EXISTING firestore.rules —
//     do NOT deploy this file as-is if your app already uses Firestore, because a
//     rules deploy REPLACES the whole ruleset. Firestore denies unmatched paths by
//     default, so these explicit deny-all rules are just defense-in-depth: `signups`,
//     `unsubscribes`, and `ratelimits` are written ONLY by the `signup` / `unsubscribe`
//     Cloud Functions (the Admin SDK bypasses rules), and no client (web or app) may
//     read or write them directly.
service cloud.firestore {
  match /databases/{database}/documents {

    match /signups/{doc} {
      allow read, write: if false;
    }
    match /unsubscribes/{doc} {
      allow read, write: if false;
    }
    match /ratelimits/{doc} {
      allow read, write: if false;
    }

    // ... your app's other collections keep their existing rules here ...
  }
}
